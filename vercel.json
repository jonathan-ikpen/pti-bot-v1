{
    "version": 2,
    "builds": [
      {
        "src": "server.py",
        "use": "@vercel/python",
        "config": {
          "maxLambdaSize": "15mb",
          "requirements": "requirements.txt",
          "runtime": "python3.10"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "server.py"
      }
    ],
    "env": {
      "GOOGLE_API_KEY": "GOOGLE_API_KEY",
      "FIRECRAWL_API_KEY": "FIRECRAWL_API_KEY",
      "LLMA_INDEX_API_KEY": "LLMA_INDEX_API_KEY"
    }
  }